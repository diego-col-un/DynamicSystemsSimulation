{UTF-8}
Población= INTEG (
	Nacimientos-Defunciones,
		1000)
	~	personas
	~	Nivel de poblacion total del sistema
	|

Nacimientos=
	Población*Tasa de Natalidad
	~	personas/semana
	~	Flujo de entrada al nivel de poblacion
	|

Defunciones=
	Población/Esperanza de Vida
	~	personas/semana
	~	Flujo de salida del nivel de poblacion
	|

Tasa de Natalidad=
	0.05
	~	1/semana
	~	Tasa de natalidad constante del 5% semanal
	|

Esperanza de Vida=
	100
	~	semana
	~	Esperanza de vida media constante
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	semana
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	semana
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	semana [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	semana [0,?]
	~	The time step for the simulation.
	|

